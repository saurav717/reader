{
  "name": "koios",
  "productName": "Koios",
  "version": "0.16.0",
  "private": true,
  "description": "Koios for research papers, as an app: its own window, the Koios Companion set up and started with it.",
  "homepage": "https://koios.dev/",
  "author": {
    "name": "saurav717",
    "email": "saurav717@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-companion": "node scripts/prepare-companion.mjs",
    "dist": "node scripts/prepare-companion.mjs && electron-builder --config electron-builder.config.cjs --publish never",
    "pack": "node scripts/prepare-companion.mjs && electron-builder --config electron-builder.config.cjs --dir --publish never"
  },
  "dependencies": {
    "@recallai/desktop-sdk": "2.0.39",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "desktopName": "koios.desktop"
}
