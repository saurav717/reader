  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#8b877c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#2f7a3f"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#a2640a"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#8a3b8f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.other.caps"
      ],
      "settings": {
        "foreground": "#a2640a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#2d64a0"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#8a3b8f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#55524a"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#1a1a17"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#55524a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#1f5e52",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#1a1a17",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#1a1a17",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#2d64a0"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#55524a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2f7a3f"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#8f2f2f"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#8f2f2f"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#2d64a0",
    "method": "#2d64a0",
    "class": "#2d64a0",
    "type": "#2d64a0",
    "keyword": "#8a3b8f",
    "number": "#a2640a",
    "string": "#2f7a3f",
    "parameter": "#55524a",
    "variable.readonly": "#a2640a",
    "decorator": "#8a3b8f"
  }
}
