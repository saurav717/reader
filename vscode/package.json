{
  "name": "reader-playground",
  "displayName": "Reader Playground",
  "description": "Your Reader playgrounds in VS Code: the Companion's projects, the papers they cite, and the machine they run on.",
  "version": "0.1.0",
  "publisher": "saurav717",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/saurav717/reader" },
  "homepage": "https://saurav717.github.io/reader/playground",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Data Science", "Notebooks", "Other"],
  "keywords": ["reader", "papers", "jupyter", "playground", "research"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "reader", "title": "Reader", "icon": "media/reader.svg" }]
    },
    "views": {
      "reader": [
        { "id": "reader.projects", "name": "Projects" },
        { "id": "reader.papers", "name": "Papers it cites" },
        { "id": "reader.companion", "name": "Companion" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reader.projects",
        "contents": "No projects yet. Make one on the site — Playground → Blank project, on This computer — and it appears here.\n[Open the Playground](command:reader.openPlayground)"
      },
      {
        "view": "reader.papers",
        "contents": "Open a Reader project to see the papers it cites."
      }
    ],
    "commands": [
      { "command": "reader.start", "title": "Start the Companion", "category": "Reader", "icon": "$(play)" },
      { "command": "reader.refresh", "title": "Refresh", "category": "Reader", "icon": "$(refresh)" },
      { "command": "reader.openProject", "title": "Open Project", "category": "Reader", "icon": "$(folder-opened)" },
      { "command": "reader.openOnSite", "title": "Open on the Site", "category": "Reader", "icon": "$(link-external)" },
      { "command": "reader.openPlayground", "title": "Open the Playground", "category": "Reader", "icon": "$(globe)" },
      { "command": "reader.openPaper", "title": "Open the Paper", "category": "Reader", "icon": "$(book)" },
      { "command": "reader.useEnvironment", "title": "Use the Companion's Python for This Project", "category": "Reader" }
    ],
    "menus": {
      "view/title": [
        { "command": "reader.refresh", "when": "view == reader.projects", "group": "navigation" },
        { "command": "reader.openPlayground", "when": "view == reader.projects", "group": "navigation" },
        { "command": "reader.start", "when": "view == reader.companion && !reader.running", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "reader.openOnSite", "when": "view == reader.projects && viewItem == project.onSite", "group": "inline" },
        { "command": "reader.openProject", "when": "view == reader.projects && viewItem =~ /^project/", "group": "inline" }
      ],
      "commandPalette": [
        { "command": "reader.openProject", "when": "false" },
        { "command": "reader.openPaper", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Reader",
      "properties": {
        "reader.site": {
          "type": "string",
          "default": "https://saurav717.github.io/reader/",
          "description": "The reader's address. The Companion's settings name it once it has run; this is used before that."
        },
        "reader.setPythonInterpreter": {
          "type": "boolean",
          "default": true,
          "description": "In a Reader project, point the Python extension at the Companion's environment (~/Reader/.venv), so notebooks and the terminal use the same Python as the site."
        }
      }
    }
  }
}
