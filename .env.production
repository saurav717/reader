# The OAuth client ID this site's builds are compiled with, so the deployed app
# comes with it already filled in rather than asking whoever opens it.
#
# A client ID is not a secret. It is visible in the page source of every
# browser-side OAuth flow by design, and it is useless anywhere else: Google
# only honours it on the origins listed under "Authorised JavaScript origins"
# on the client itself. The client *secret* is a different thing, is not used
# by this app at all, and belongs in none of these files.
#
# Settings → Google OAuth client ID overrides this in any browser that sets it,
# so someone running their own copy does not have to rebuild.
VITE_GOOGLE_CLIENT_ID=308274983351-s52d0ustml5bneg91ju6of40tmitnaoa.apps.googleusercontent.com
