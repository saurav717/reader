{
  "name": "reader proxy with a screen",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "noPassword",
      "webPort": "6080",
      "vncPort": "5901"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "VNC_RESOLUTION": "1280x800x24",
    "READER_PROFILE_DIR": "/workspaces/.reader/browser-profile",
    "READER_SCHOLAR_PROFILE_DIR": "/workspaces/.reader/scholar-profile",
    "PLAYWRIGHT_BROWSERS_PATH": "/workspaces/.reader/pw-browsers"
  },
  "forwardPorts": [8080, 6080],
  "portsAttributes": {
    "8080": { "label": "reader proxy (make this one public)", "onAutoForward": "silent" },
    "6080": { "label": "the proxy's screen (keep private)", "onAutoForward": "silent" },
    "5901": { "label": "vnc (unused)", "onAutoForward": "ignore" }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "postAttachCommand": "bash .devcontainer/address.sh"
}
